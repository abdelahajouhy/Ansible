################################################################################
# ======================== KIBANA Configuration ================================
########################### AJOUHY ABDELAH #####################################

# ============================ Kibana ============================
server.name: "{{ inventory_hostname }}"
server.host: "{{ kibana_server_host }}"
server.port: {{ kibana_server_port }}

# ========================= Elasticsearch ========================
elasticsearch.hosts:
{% for host in kibana_elasticsearch_hosts %}
  - "{{ host }}"
{% endfor %}

elasticsearch.username: "{{ kibana_elasticsearch_username }}"

# ============================== TLS =============================
{% if kibana_security_enabled | default(false) | bool %}

# Kibana HTTPS
server.ssl.enabled: true
server.ssl.certificate: "{{ kibana_certs_dir }}/certificate.pem"
server.ssl.key: "{{ kibana_certs_dir }}/private.key"
server.publicBaseUrl: "https://kibana-{{ inventory_hostname }}.{{ kibana_domain }}:5601"

# Kibana -> Elasticsearch HTTPS
elasticsearch.ssl.certificateAuthorities:
  - "{{ kibana_certs_dir }}/ca_chain.pem"
elasticsearch.ssl.verificationMode: full

{% endif %}

# ============================ Paths =============================
path.data: "{{ kibana_app_dir }}/data"

# =========================== Logging ============================
logging:
  appenders:
    file:
      type: file
      fileName: "{{ kibana_log_dir }}/kibana.log"
      layout:
        type: json
  root:
    appenders:
      - default
      - file